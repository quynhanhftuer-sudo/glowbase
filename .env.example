# Sao chép thành .env rồi điền. KHÔNG đưa file .env lên GitHub.
PORT=3000
NODE_ENV=development          # đặt "production" khi chạy thật (bật cookie Secure)

# Gmail của admin: ai đăng ký bằng Gmail này sẽ có quyền duyệt hồ sơ
ADMIN_EMAIL=ban@gmail.com

# Chuỗi ngẫu nhiên dài (tuỳ chọn). TRUST_PROXY=1 nếu chạy sau Render/Railway/Nginx.
# APP_SECRET=
# TRUST_PROXY=1
# DATA_DIR=/var/data            # nơi lưu database + ảnh; trên hosting phải là ổ đĩa bền vững

# Số giây không thao tác thì phải đăng nhập lại (mặc định 900 = 15 phút)
# SESSION_IDLE_SEC=900

# ---- DATABASE ----
# Chạy thật (Render…): dùng Turso (miễn phí) để dữ liệu KHÔNG mất khi hosting khởi động lại. Lấy 2 giá trị này ở bước "Tạo database Turso" trong README.
# TURSO_DATABASE_URL=libsql://ten-db-tenban.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# Để trống cả hai khi chạy thử trên máy: dữ liệu lưu trong file data/glowbase.db (DATA_DIR đổi nơi lưu).
